# Copy to .env. Secrets live only in env, never in git.
DATABASE_URL=postgres://eduforge:eduforge@localhost:5433/eduforge
POSTGRES_PORT=5433

# Demo mode: divides every pause/interval by this factor (1 = real time, 1440 = a day in a minute).
TIME_SCALE=1

# Learning engine defaults (SPEC F5, D-11, D-14)
NODE_PASS_THRESHOLD=0.8
BKT_P_INIT=0.2
BKT_LEARN=0.15
BKT_SLIP=0.1
NODE_TEST_QUESTIONS_PER_SKILL=3
NODE_ATTEMPTS_PER_ROUND=2
NODE_COOLDOWN_SECONDS=86400

# Question bank (SPEC F3-R1, F3-R6): minimum validated questions per skill, pass score for open answers
POOL_NODE_MIN_PER_SKILL=4
POOL_EXAM_MIN_PER_SKILL=3
OPEN_PASS_THRESHOLD=0.7

# Tutor limits (SPEC F6, NFR-4, NFR-7): messages per minute and tokens per user per day (tutor + guard calls)
TUTOR_RATE_PER_MINUTE=6
TUTOR_DAILY_TOKEN_BUDGET=60000

# Experiment (RESEARCH.md): the courses (slugs) that are topic A and topic B, the wait before the delayed post-test
# (scaled by TIME_SCALE) and how often the browser sends a learning-time heartbeat.
EXPERIMENT_COURSE_A=experiment-a
EXPERIMENT_COURSE_B=experiment-b
EXPERIMENT_DELAY_SECONDS=604800
EXPERIMENT_HEARTBEAT_SECONDS=30

# Exam (SPEC F8, D-18)
EXAM_PASS_PCT=0.7
EXAM_ATTEMPTS_PER_ROUND=2
EXAM_COOLDOWN_SECONDS=604800

# Proctoring (SPEC F9)
SNAPSHOT_INTERVAL_SECONDS=60
EVIDENCE_RETENTION_DAYS=30

# Auth (SPEC NFR-4): server-side session lifetime; failed logins allowed per window (per email and per IP)
SESSION_TTL_SECONDS=604800
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900
# Reverse proxies in front of the app that append to X-Forwarded-For. 0 = ignore the header, so the
# per-IP login limit is off (only the per-email one applies). Set 1 behind a single proxy.
TRUSTED_PROXY_HOPS=0

# Embedding dimension is an open question (SPEC OQ-2), so it is config, not code.
EMBEDDING_DIM=1024

# LLM: only the mock provider exists in M00.
LLM_PROVIDER=mock

# Embeddings and video transcription (SPEC F2). `mock` needs no key. `openai` needs OPENAI_API_KEY and
# is meant for an OpenAI-compatible API; text-embedding-3-large supports Ukrainian and the 1024 size.
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=text-embedding-3-large
TRANSCRIPTION_PROVIDER=mock
WHISPER_MODEL=whisper-1
OPENAI_API_KEY=

# Uploaded videos. Absolute path, shared by the web app and the worker (default: ~/.eduforge/storage).
STORAGE_DIR=
