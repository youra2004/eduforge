{
  "name": "eduforge",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter @eduforge/web --filter @eduforge/worker dev",
    "build": "pnpm -r build",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "pnpm --filter @eduforge/db migrate",
    "db:rollback": "pnpm --filter @eduforge/db rollback",
    "create-admin": "pnpm --filter @eduforge/core create-admin",
    "seed-demo": "pnpm --filter @eduforge/core seed-demo",
    "simulate-tutor": "pnpm --filter @eduforge/core simulate-tutor",
    "seed-experiment": "pnpm --filter @eduforge/core seed-experiment",
    "generate-signing-key": "pnpm --filter @eduforge/core generate-signing-key",
    "import-course": "pnpm --filter @eduforge/core import-course"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "eslint": "^10.15.0",
    "pg": "^8.23.1",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
